# Copy to .env and fill in. Never commit .env.
MODEL_PROVIDER=meta
MODEL_NAME=muse-wonder-1.0
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
# Optional: run on a non-Meta OpenAI-compatible provider (results are stored and
# labelled separately, never as the Meta entry's result):
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=<provider endpoint>
# MODEL_NAME=<model id>
# MODEL_IMAGES=off   # only if the model is text-only
# BASETEN_API_KEY=   # optional Muse Spark Open reviewer
